# SlotScout on Vercel: the same image as Dockerfile (API plus built web app), run as a Vercel container.
# Vercel builds this file from the repository root on every push and sets PORT at run time.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/engine/package.json packages/engine/
COPY packages/pipeline/package.json packages/pipeline/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine
# Vercel's edge sits in front, so client addresses come from X-Forwarded-For (rate limits per visitor).
ENV NODE_ENV=production HOST=0.0.0.0 TRUST_PROXY=true
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/engine/package.json packages/engine/
COPY packages/pipeline/package.json packages/pipeline/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --omit=dev --workspace @slotscout/api --include-workspace-root=false && npm cache clean --force
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/web/dist apps/web/dist
# Registers, rules and reports as committed: the site serves exactly what the pipeline last wrote.
COPY data data
COPY sources sources
COPY rules rules
COPY reports reports
# Report-a-problem submissions; container storage is not kept between deployments.
RUN mkdir -p /feedback && chown -R node:node /feedback
ENV FEEDBACK_DIR=/feedback
USER node
EXPOSE 8787
CMD ["node", "apps/api/dist/server.mjs"]
