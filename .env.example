# Copy to .env (never commit it). All values are optional.
PORT=8787
HOST=0.0.0.0
SITE_URL=https://slotscout.ca
# Set to true behind a reverse proxy or CDN so rate limits see the real client.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=60
UPSTREAM_TIMEOUT_MS=20000
# Descriptive user agent for every request to government servers (PRD 10.3).
USER_AGENT=SlotScoutBot/0.1 (+https://slotscout.ca/about; data@slotscout.ca)

# Pipeline (Addendum A 10.1). Optional: with a key the pipeline runs in "api" mode and calls the
# Claude API itself; without one it runs in "agent" mode inside a Claude Code session. Never commit .env.
ANTHROPIC_API_KEY=
# Where report-a-problem submissions go (git-ignored). In production keep it outside the image,
# for example /var/lib/slotscout/feedback.
FEEDBACK_DIR=data/feedback
